# WebSocket server configuration
# Hostname for the WebSocket server (used in production CSP headers)
# NEXT_PUBLIC_WS_HOST=ws.example.com

# Port for the WebSocket server (defaults to current page port if not set)
# NEXT_PUBLIC_WS_PORT=8080

# Full WebSocket URL override (takes precedence over host/port auto-detection)
# NEXT_PUBLIC_WS_URL=ws://localhost:8080
